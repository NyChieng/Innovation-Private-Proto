{
  "name": "florascan-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Prototype X / FloraScan - Smart Ground-Truthing & Digital Biodiversity System (COS30049)",
  "scripts": {
    "dev": "node Server/index.js",
    "dev:test": "node Server/index.js --test-limits",
    "start": "node Server/index.js",
    "http": "node Server/index.js --http",
    "https": "node Server/index.js",
    "build": "vite build",
    "preview": "node Server/index.js --prod",
    "port": "node Server/port.js",
    "import:species": "node scripts/import-species.mjs",
    "import:tints": "node scripts/photo-tints.mjs",
    "test": "node --test tests/security.test.mjs && node tests/i18n.test.mjs && node tests/api.test.mjs && node tests/ui.test.mjs && node tests/passkey.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "demo:security": "node scripts/demo-security.mjs",
    "test:api": "node tests/api.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test:i18n": "node tests/i18n.test.mjs",
    "test:passkey": "node tests/passkey.test.mjs",
    "test:iot": "node tests/iot-mqtt.test.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/seed-mysql.mjs",
    "db:reset": "node scripts/db-setup.mjs --reset && node scripts/seed-mysql.mjs --reset",
    "pretest": "node scripts/test-db.mjs",
    "db:test": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/public-sans": "^5.2.6",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "mqtt": "^5.16.0",
    "mysql2": "^3.24.5",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.12.0",
    "vite": "^5.4.11"
  }
}
