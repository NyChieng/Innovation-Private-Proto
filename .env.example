# Copy this file to .env and fill in the value. .env is gitignored - never
# commit it, and never paste the filled-in version into a chat or an issue:
# it contains the database password.

# Supabase: Connect > Session pooler. The session pooler is deliberate - the
# direct connection is IPv6-only on the free tier, which most hosts cannot
# reach. Replace [YOUR-PASSWORD] with the password shown when the project was
# created; if it has been lost, reset it under Settings > Database.
#
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

DATABASE_URL=

# The permanent public address of the site, once it is hosted. Printed QR tags
# encode this, so set it before printing any tag for real - a tag printed with
# the wrong address is just a sticker. Left blank, the server uses this
# machine's network address, which is what a local demo wants.
# PUBLIC_BASE_URL=https://florascan.example.org
