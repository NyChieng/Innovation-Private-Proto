# HOSTING BRANCH
#
# Copy this file to .env and fill in the values. .env is gitignored - never
# commit the filled-in version, and never paste it into a chat or an issue: it
# contains the database password.
#
# On Render these are set in the dashboard instead, not from a file.
#
# For working on your own machine, use the `local` branch, which points at your
# own MySQL. The code is identical; only this file differs.


# ---------------------------------------------------------------------
# Database - required
# ---------------------------------------------------------------------
# The register lives in MySQL. The server will not start without this, and
# there is no in-memory fallback: a prototype quietly serving empty data that
# is never saved would be worse than one that says what is missing.
#
# Aiven: Service overview > Connection information. These five are what the
# rest of the group shares, so one .env works for everybody.

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb

# A single connection string works too, and is what some hosts prefer. It wins
# over the five above if both are set.
# DATABASE_URL=mysql://user:password@host:port/defaultdb

# TLS. Aiven signs its servers with its own private certificate authority, so
# a verified connection needs ca.pem from the service page. Download it and
# drop it in the project root - it is found there automatically, no setting
# needed, and it is a public certificate so it belongs in the repository.
#
# Without it the connection is still encrypted but unverified, and the server
# says so at startup.
#
# On a host where adding a file is awkward, paste the certificate itself as a
# single line, with the line breaks written as \n:
# MYSQL_SSL_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
#
# Or point at the file somewhere else:
# MYSQL_SSL_CA=./ca.pem

# Force TLS off for an awkward local server.
# MYSQL_SSL=off


# ---------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------
# The permanent public address of the site once it is hosted. Printed QR tags
# encode this, so set it before printing any tag for real - a tag printed with
# the wrong address is just a sticker. Left blank, the server uses this
# machine's network address, which is what a local demo wants.
#
# The admin setting of the same name overrides this, so a live site can be
# corrected without a redeploy.
# PUBLIC_BASE_URL=https://florascan.onrender.com


# ---------------------------------------------------------------------
# First run against an empty database
# ---------------------------------------------------------------------
#   npm run db:setup     apply plant_registry_schema.sql and the extensions
#   npm run db:seed      load the demo dataset
#
# db:setup needs plant_registry_schema.sql in the repository root.
