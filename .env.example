# Copy this file to .env and fill in the values. .env is gitignored - never
# commit it, and never paste the filled-in version into a chat or an issue:
# it contains the database password.
#
# On Render these are set in the dashboard instead, not from a file.


# ---------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------
# Leave blank and the prototype runs entirely in memory, reseeding on every
# start. That is the right setting for a quick local demo - nobody can leave
# it in a mess. Set it and the store saves itself after every change and comes
# back where it left off.
#
# Local XAMPP / MySQL:
#   DATABASE_URL=mysql://root@127.0.0.1:3306/florascan
#
# Aiven (Service overview > Connection information > Service URI). Aiven gives
# a mysql:// URI already in this shape; if the password contains @ : / ? # [
# or ], percent-encode it or the URL cannot be parsed.
#   DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb

DATABASE_URL=

# Path to the provider's CA certificate, for a properly verified TLS
# connection. Aiven offers it as ca.pem on the service page. Without it a
# remote connection is still encrypted, just unverified; a local one does not
# use TLS at all.
# MYSQL_SSL_CA=./ca.pem

# Force TLS off for an awkward local server.
# MYSQL_SSL=off


# ---------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------
# The permanent public address of the site once it is hosted. Printed QR tags
# encode this, so set it before printing any tag for real - a tag printed with
# the wrong address is just a sticker. Left blank, the server uses this
# machine's network address, which is what a local demo wants.
#
# The admin setting of the same name overrides this, so a live site can be
# corrected without a redeploy.
# PUBLIC_BASE_URL=https://florascan.onrender.com
